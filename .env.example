# Copy to .env before running: cp .env.example .env
# Never commit .env — it is gitignored.

# --- Auth database (auth-db container) ---
AUTH_DB_USER=ecommerce_auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=ecommerce_auth_database
# Host port to reach Postgres from your machine (container always listens on 5432)
AUTH_DB_PORT=5433

# --- Auth service ---
# Required. Use a long random string in local .env (not this placeholder).
JWT_HASH=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Host port mapped to auth container :3000 (architecture: auth :3001)
AUTH_PORT=3001

# --- DATABASE_URL patterns ---
# Inside Docker (set automatically in docker-compose.yml for the auth service):
#   postgresql://USER:PASSWORD@auth-db:5432/DB_NAME?schema=public
#
# Local dev against auth-db exposed on the host:
#   postgresql://${AUTH_DB_USER}:${AUTH_DB_PASSWORD}@localhost:${AUTH_DB_PORT}/${AUTH_DB_NAME}?schema=public

# --- RabbitMQ (stack runs in compose; auth does not connect yet) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Copy to .env before running: cp .env.example .env
# Never commit .env — it is gitignored.

# --- Auth database (auth-db container) ---
AUTH_DB_USER=ecommerce_auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=ecommerce_auth_database
# Host port to reach Postgres from your machine (container always listens on 5432)
AUTH_DB_PORT=5433

# --- Catalog database (catalog-db container) ---
CATALOG_DB_USER=ecommerce_catalog_user
CATALOG_DB_PASSWORD=change-me
CATALOG_DB_NAME=ecommerce_catalog_database
CATALOG_DB_PORT=5434

# --- Inventory database (inventory-db container) ---
INVENTORY_DB_USER=ecommerce_inventory_user
INVENTORY_DB_PASSWORD=change-me
INVENTORY_DB_NAME=ecommerce_inventory_database
INVENTORY_DB_PORT=5435

# --- Cart database (cart-db container) ---
CART_DB_USER=ecommerce_cart_user
CART_DB_PASSWORD=change-me
CART_DB_NAME=ecommerce_cart_database
CART_DB_PORT=5436

# --- Orders database (orders-db container) ---
ORDERS_DB_USER=ecommerce_orders_user
ORDERS_DB_PASSWORD=change-me
ORDERS_DB_NAME=ecommerce_orders_database
ORDERS_DB_PORT=5437

# --- Payment database (payment-db container) ---
PAYMENT_DB_USER=ecommerce_payment_user
PAYMENT_DB_PASSWORD=change-me
PAYMENT_DB_NAME=ecommerce_payment_database
PAYMENT_DB_PORT=5438

# --- API Gateway ---
# Host port mapped to api-gateway container :3000 (architecture: gateway :3000)
GATEWAY_PORT=3000
# Upstream URLs — local dev (services exposed on host ports):
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3005
CART_SERVICE_URL=http://localhost:3003
ORDERS_SERVICE_URL=http://localhost:3004
# Inside Docker (set automatically in docker-compose.yml):
#   AUTH_SERVICE_URL=http://auth:3000
#   CATALOG_SERVICE_URL=http://catalog:3000
#   INVENTORY_SERVICE_URL=http://inventory:3000
#   CART_SERVICE_URL=http://cart:3000
#   ORDERS_SERVICE_URL=http://orders:3000

# --- Auth service ---
# Required. Use a long random string in local .env (not this placeholder).
JWT_HASH=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
# Host port mapped to auth container :3000 (architecture: auth :3001)
AUTH_PORT=3001

# --- Catalog service ---
# Host port mapped to catalog container :3000 (architecture: catalog :3002)
CATALOG_PORT=3002

# --- Inventory service ---
# Host port mapped to inventory container :3000 (architecture: inventory :3005)
INVENTORY_PORT=3005

# --- Cart service ---
# Host port mapped to cart container :3000 (architecture: cart :3003)
CART_PORT=3003
# Uses CATALOG_SERVICE_URL (above) for HTTP validation against catalog

# --- Orders service ---
# Host port mapped to orders container :3000 (architecture: orders :3004)
ORDERS_PORT=3004
# Uses CART_SERVICE_URL (above) for HTTP checkout against cart
# Uses RABBITMQ_URL (below) for order.created + stock.* + payment.* consumers

# --- Payment service ---
# Host port mapped to payment container :3000 (architecture: payment :3006)
PAYMENT_PORT=3006
# Mock charge outcome: success (default) | failure | random
PAYMENT_FORCE_RESULT=success

# --- DATABASE_URL patterns ---
# Inside Docker (set automatically in docker-compose.yml per service):
#   postgresql://USER:PASSWORD@<service>-db:5432/DB_NAME?schema=public
#
# Local dev against DB containers exposed on the host:
#   postgresql://${CATALOG_DB_USER}:${CATALOG_DB_PASSWORD}@localhost:${CATALOG_DB_PORT}/${CATALOG_DB_NAME}?schema=public
#   postgresql://${INVENTORY_DB_USER}:${INVENTORY_DB_PASSWORD}@localhost:${INVENTORY_DB_PORT}/${INVENTORY_DB_NAME}?schema=public
#   postgresql://${CART_DB_USER}:${CART_DB_PASSWORD}@localhost:${CART_DB_PORT}/${CART_DB_NAME}?schema=public
#   postgresql://${ORDERS_DB_USER}:${ORDERS_DB_PASSWORD}@localhost:${ORDERS_DB_PORT}/${ORDERS_DB_NAME}?schema=public
#   postgresql://${PAYMENT_DB_USER}:${PAYMENT_DB_PASSWORD}@localhost:${PAYMENT_DB_PORT}/${PAYMENT_DB_NAME}?schema=public

# --- RabbitMQ (compose stack) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# Used by catalog, inventory, cart, orders and payment (local dev against compose RabbitMQ):
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Inside Docker (set automatically in docker-compose.yml for catalog/inventory/cart/orders/payment):
#   RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
